# Semantic Scholar API Key
# Get one at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex API Key
# OpenAlex is free and does not require an API key by default.
# Premium keys available at: https://openalex.org/upgrade
OPENALEX_API_KEY=

# Crossref API Key
# Crossref metadata is free. Premium keys available for +50 req/s.
# See: https://www.crossref.org/documentation/retrieve-metadata/rest-api/api-keys/
CROSSREF_API_KEY=

# ArXiv API Key
# ArXiv API is free and does not require authentication.
ARXIV_API_KEY=
